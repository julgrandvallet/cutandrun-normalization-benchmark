manifest {
    name            = 'cutandrun-normalization-benchmark'
    author          = 'Julian Grandvallet-Contreras'
    description     = 'Which normalization method recovers a known genome-wide change in CUT&RUN signal?'
    homePage        = 'https://github.com/julgrandvallet/cutandrun-normalization-benchmark'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    samplesheet   = "${projectDir}/assets/samplesheet.csv"
    contrasts     = "${projectDir}/assets/contrasts.csv"
    outdir        = 'results'
    genome_cache  = "${projectDir}/genomes"

    target_genome    = 'hg38'
    spikein_genomes  = ['dm6', 'sacCer3']
    igg_label        = 'IgG'

    genomes = [
        hg38    : 'https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.fa.gz',
        dm6     : 'https://hgdownload.soe.ucsc.edu/goldenPath/dm6/bigZips/dm6.fa.gz',
        sacCer3 : 'https://hgdownload.soe.ucsc.edu/goldenPath/sacCer3/bigZips/sacCer3.fa.gz'
    ]

    // Methods must match column names emitted by bin/scale_factors.py.
    methods = ['none', 'library_size', 'spikein_dm6', 'spikein_sacCer3']

    remove_duplicates         = false   // see docs/decisions.md
    peak_qvalue               = 0.01
    macs_gsize                = 'hs'
    consensus_merge_distance  = 100
    fdr                       = 0.05
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single { cpus = 1;  memory = 4.GB;  time = 1.h  }
    withLabel: process_medium { cpus = 4;  memory = 16.GB; time = 6.h  }
    withLabel: process_high   { cpus = 12; memory = 48.GB; time = 16.h }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/julgrandvallet/cutandrun-normalization-benchmark:0.1.0'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container = 'ghcr.io/julgrandvallet/cutandrun-normalization-benchmark:0.1.0'
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/env.yml"
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = System.getenv('NXF_SLURM_QUEUE') ?: 'normal'
        executor.queueSize     = 32
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Tiny synthetic dataset. Exercises the full DAG in minutes so CI can
    // verify the wiring without moving 10 GB of reads.
    test {
        params.samplesheet = "${projectDir}/assets/test/samplesheet.csv"
        params.contrasts   = "${projectDir}/assets/test/contrasts.csv"
        params.genomes     = [ hg38: "${projectDir}/assets/test/hg38.fa.gz",
                               dm6 : "${projectDir}/assets/test/dm6.fa.gz" ]
        params.spikein_genomes = ['dm6']
        params.methods         = ['none', 'library_size', 'spikein_dm6']
        params.macs_gsize      = 100000
        params.peak_qvalue     = 0.5
        process { withLabel: process_high   { cpus = 2; memory = 4.GB } }
        process { withLabel: process_medium { cpus = 2; memory = 4.GB } }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
